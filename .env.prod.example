# Profoundd Production Environment (Apollo9)
# Copy to .env.prod and fill in values

FLASK_APP=profoundd.app
FLASK_ENV=production
SECRET_KEY=CHANGE_ME
DOMAIN=profoundd.com

# Elasticsearch (set by docker-compose, no need to change)
# ELASTICSEARCH_URL=http://elasticsearch:9200

# Database (SQLite inside container, persisted via volume)
DATABASE_URL=sqlite:///data/profoundd.db

# Admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME

# Crawler
CRAWL_INTERVAL_MINUTES=60
MAX_ARTICLES_PER_FEED=50
RESPECT_ROBOTS_TXT=true
USER_AGENT=ProfounddBot/1.0 (+https://profoundd.com/bot)
CRAWL_DELAY_SECONDS=2
CONCURRENT_REQUESTS=4

# AI (from DO usmediaratings)
ANTHROPIC_API_KEY=CHANGE_ME
# OPENAI_API_KEY=
