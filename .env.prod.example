# Profoundd Production Environment (Apollo9)
# Copy to .env.prod and fill in values

FLASK_APP=profoundd.app
FLASK_ENV=production
SECRET_KEY=CHANGE_ME
DOMAIN=profoundd.com

# Elasticsearch (set by docker-compose, no need to change)
# ELASTICSEARCH_URL=http://elasticsearch:9200

# Database (SQLite inside container, persisted via volume)
DATABASE_URL=sqlite:///data/profoundd.db

# Admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME

# Crawler
CRAWL_INTERVAL_MINUTES=60
MAX_ARTICLES_PER_FEED=50
RESPECT_ROBOTS_TXT=true
USER_AGENT=ProfounddBot/1.0 (+https://profoundd.com/bot)
CRAWL_DELAY_SECONDS=2
CONCURRENT_REQUESTS=4

# AI (from DO usmediaratings)
ANTHROPIC_API_KEY=CHANGE_ME
# OPENAI_API_KEY=

# Epstein PDF file server on Azure7 (Tailscale)
# Must match EPSTEIN_FILE_SERVER_TOKEN on Azure7's /home/mark/azure7-file-server.env
EPSTEIN_FILE_SERVER_URL=http://100.71.230.11:8090
EPSTEIN_FILE_SERVER_TOKEN=CHANGE_ME

# AI Explain provider: "anthropic" (default, Claude Sonnet) or "ollama" (local)
AI_EXPLAIN_PROVIDER=anthropic
OLLAMA_URL=http://10.0.6.1:11434
OLLAMA_MODEL=mistral:latest
